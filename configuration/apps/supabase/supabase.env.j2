# Gerado pelo Ansible. Os segredos vêm do inventário; o resto é literal aqui.

# ---------- Rede ----------
NETWORK_NAME=supabase

# ---------- Postgres ----------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD={{ supabase_postgres_password }}
POSTGRES_PORT_EXTERNAL=5432

# ---------- JWT ----------
# ANON_KEY e SERVICE_ROLE_KEY são JWTs HS256 assinados com JWT_SECRET. Trocar o
# secret obriga a regerar as duas (ver README).
JWT_SECRET={{ supabase_jwt_secret }}
JWT_EXPIRY=3600
ANON_KEY={{ supabase_anon_key }}
SERVICE_ROLE_KEY={{ supabase_service_role_key }}

# ---------- URLs públicas ----------
# A 8000 fica com o painel do Coolify (default oficial dele), então o Kong vai
# para a 8001.
#
# Servidor local, sem DNS que resolva domínio para este IP: as URLs são o IP e
# a porta. SUPABASE_PUBLIC_URL é o endereço que o NAVEGADOR usa para falar com
# o Kong — se apontar para um domínio que não resolve, o Studio abre e não
# carrega nada. API_EXTERNAL_URL é o que o GoTrue põe nos links que gera.
KONG_HTTP_PORT=8001
KONG_HTTPS_PORT=8444
KONG_CORS_ORIGIN=*
API_EXTERNAL_URL=http://{{ inventory_hostname }}:8001
SUPABASE_PUBLIC_URL=http://{{ inventory_hostname }}:8001
SITE_URL=http://{{ inventory_hostname }}:8001
ADDITIONAL_REDIRECT_URLS=

# ---------- Studio + basic auth do dashboard ----------
STUDIO_DEFAULT_ORGANIZATION={{ supabase_studio_organization | default(domain) }}
STUDIO_DEFAULT_PROJECT=default
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD={{ supabase_dashboard_password }}

# ---------- Auth (GoTrue) ----------
# Servidor, não laboratório: signup fechado.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# ---------- SMTP ----------
# Vazio = sem envio. Com ENABLE_EMAIL_AUTOCONFIRM=true o usuário nasce
# confirmado e nada precisa ser enviado. Preenchendo, desligue o autoconfirm.
# SMTP_PORT fica em 587 mesmo sem host: o GoTrue lê como inteiro e recusa subir
# se vier vazio.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=

# ---------- Realtime (profile extras) ----------
SECRET_KEY_BASE={{ supabase_secret_key_base }}
REALTIME_ENC_KEY={{ supabase_realtime_enc_key }}

# ---------- Storage ----------
# Limite por upload, em bytes. 52428800 = 50 MB.
STORAGE_FILE_SIZE_LIMIT=52428800
STORAGE_TENANT_ID=supabase
STORAGE_REGION=local
ENABLE_IMAGE_TRANSFORMATION=false

# ---------- API S3 do Storage ----------
# Endpoint: http://{{ inventory_hostname }}:8001/storage/v1/s3 · região: STORAGE_REGION · path-style.
# As chaves ficam aqui e no inventário: se perder, releia este arquivo no servidor.
S3_PROTOCOL_ACCESS_KEY_ID={{ supabase_s3_access_key_id }}
S3_PROTOCOL_ACCESS_KEY_SECRET={{ supabase_s3_access_key_secret }}
S3_PROTOCOL_PREFIX=/storage/v1

# ---------- Edge Functions (profile extras) ----------
FUNCTIONS_VERIFY_JWT=true
