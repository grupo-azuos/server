# Gerado pelo Ansible a partir de caddy_routes (configuration/servers/<versão>/{{ server }}/vars.yml).
{% macro proxy(up, r) -%}
reverse_proxy {{ up }}{% if r.tls_insecure | default(false) %} {
		transport http {
			tls_insecure_skip_verify
		}
	}{% endif %}
{%- endmacro %}
{% for r in caddy_routes %}
{% set up = r.upstream if r.upstream is defined else (caddy_route_ips[r.server] ~ ':' ~ caddy_tunnel_port) %}

{{ r.hosts | map('regex_replace', '^', 'http://' if caddy_mode == 'local' else '') | join(', ') }} {
{% if r.path is defined %}
	handle {{ r.path }} {
		{{ proxy(up, r) }}
	}
	handle {
		respond 404
	}
{% elif r.public_path is defined %}
	handle {{ r.public_path }} {
		{{ proxy(up, r) }}
	}
	handle {
{% if r.vpn_only | default(false) %}
		import vpn_only
{% endif %}
		{{ proxy(up, r) }}
	}
{% else %}
{% if r.vpn_only | default(false) %}
	import vpn_only
{% endif %}
	{{ proxy(up, r) }}
{% endif %}
}
{% endfor %}
