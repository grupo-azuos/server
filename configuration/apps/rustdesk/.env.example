# IP ou dominio acessivel pelos clientes, sem http:// ou https://.
# A porta padrao do relay e 21117.
RUSTDESK_RELAY_SERVER=rustdesk.example.com:21117

# Use uma tag especifica para fixar a versao, se desejar.
RUSTDESK_VERSION=latest

# Y: forca relay. N: permite conexoes diretas entre os clientes.
ALWAYS_USE_RELAY=N
