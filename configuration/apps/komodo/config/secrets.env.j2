# Gerado uma vez pelo Ansible (etapa komodo) e nunca sobrescrito.
# A senha do banco e a do admin só valem na primeira subida.
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD={{ komodo_db_password }}
MONGO_INITDB_ROOT_USERNAME=komodo
MONGO_INITDB_ROOT_PASSWORD={{ komodo_db_password }}
KOMODO_INIT_ADMIN_PASSWORD={{ komodo_admin_password }}
KOMODO_JWT_SECRET={{ lookup('password', '/dev/null chars=ascii_letters,digits length=48') }}
KOMODO_WEBHOOK_SECRET={{ komodo_webhook_secret | default(lookup('password', '/dev/null chars=ascii_letters,digits length=32')) }}
